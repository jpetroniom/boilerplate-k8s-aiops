# Connection string do PostgreSQL (deve apontar para o banco do docker-compose)
DATABASE_URL=postgresql+asyncpg://aiops:aiops123@localhost:5432/aiops_k8s

# Chave de API da Anthropic (obrigatorio quando usar agentes)
ANTHROPIC_API_KEY=sk-ant-...

# Endpoint HTTP do MCP Server Kubernetes (executado localmente via npx, transport streamable HTTP)
MCP_SERVER_URL=http://localhost:3001/mcp

# Modelo do agente de analise de causa raiz
AGENT_MODEL_NAME=claude-haiku-4-5

# Maximo de chamadas ao modelo por analise
AGENT_MAX_ITERATIONS=25

# Minutos ate um relatorio EM_ANALISE estagnado ser marcado INCOMPLETO
ANALYSIS_STALE_TIMEOUT_MINUTES=30

# Intervalo da coleta de eventos Warning, em minutos
EVENT_COLLECTION_INTERVAL_MINUTES=3
